# Copia a .env y rellena. Los valores "dev-*" son SOLO para probar en local.

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret
# Vacíos = modo local: el bot no llama a Meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API (verifica la vigente en developers.facebook.com/docs/graph-api/changelog)
GRAPH_API_VERSION=v23.0

# --- Administración ---
ADMIN_TOKEN=dev-admin-token

# --- Cerebro: rules | llm ---
BRAIN=rules
# openai | anthropic (solo si BRAIN=llm; sin clave vuelve a las reglas)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Datos ---
NEGOCIO_PATH=config/negocio.yaml
DB_PATH=data/conversaciones.db
